# crowdsec-gram-bot configuration.
# systemd: copied to /etc/crowdsec-gram-bot.env (0600) by install.sh
# docker/dev: source as .env
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_ID=
CROWDSEC_LAPI_URL=http://127.0.0.1:8080
CROWDSEC_MACHINE_LOGIN=telegram-bot
CROWDSEC_MACHINE_PASSWORD=
ALLOWLIST_ID=telegram-temp
WHITELIST_TTL=2160h
LIST_LIMIT=50
# 0 = LAPI only, 1 = cscli only, auto = LAPI first with cscli fallback
USE_CSCLI=auto
GITHUB_REPO=carvalab/crowdsec-gram-bot
# Required only for private repos (needs contents:read). Empty = public.
GITHUB_TOKEN=
